{
  "_comment": "Copy this file to rdc_tool.json and edit the paths. The script reads rdc_tool.json from the cwd or from the project root.",

  "captures": [
    "path/to/your/capture1.rdc",
    "path/to/your/capture2.rdc"
  ],

  "renderdoc": {
    "development_dir": "path/to/renderdoc/x64/Development",
    "pymodules_dir": "path/to/renderdoc/x64/Development/pymodules",
    "python": "path/to/python36/python.exe"
  },

  "export_texture": {
    "pass_report": "path/to/search_texture_passes.txt",
    "out_dir": null,
    "type": "dds",
    "mip": -1,
    "slice": -1,
    "verify_replay": false
  }
}
